	<!-- Camera (Feature 12, camera package) -->
	<key>NSCameraUsageDescription</key>
	<string>KatharErase needs camera access to take product photos for background removal.</string>

	<!--
		Photo library — TWO keys required, not one. Section 5's original
		File 57 spec listed only NSPhotoLibraryUsageDescription. Gap 13
		(live-verified during Phase 7): gal's own current documentation
		requires NSPhotoLibraryAddUsageDescription as well — "Required",
		distinct from NSPhotoLibraryUsageDescription which gal's docs
		describe as "Required for iOS < 14 or saving to album". Both are
		needed: the Add key for gal's write-only save flow (Feature 5),
		and the full-access key for image_picker's gallery read flow
		(home_screen.dart / camera_screen.dart's gallery shortcut).
	-->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>KatharErase saves your edited photos to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>KatharErase needs photo library access so you can pick a photo to edit.</string>

	<!-- ATT (Section 11 compliance table, A10) -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Used to show relevant ads. You can decline.</string>

	<!--
		AdMob App ID — REQUIRED by google_mobile_ads or the app crashes on
		ad SDK init, same requirement as Android's APPLICATION_ID meta-data
		(AndroidManifest.xml, File 56). Not present in Section 5's original
		File 57 spec. Section 1a shows "AdMob — iOS app entry" as Pending.
		Bracket placeholder, not a fabricated ID.
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
