  "helpCutout2": "किनारे की कोमलता कट-आउट के किनारे को 0 से 20 पिक्सल तक मुलायम करती है।",
  "helpCutout3": "ऊपर की आँख वाली बटन तुलना के लिए आपकी मूल फ़ोटो दिखाती है। वापस जाने के लिए उस पर फिर टैप करें। मूल फ़ोटो दिखने तक ब्रश रुका रहता है।",
  "helpCutout4": "काँच, जूते, बैग और बोतल जैसे कठिन विषयों के लिए HD कटआउट पाएँ पर टैप करें। HD मॉडल सिर्फ़ एक बार डाउनलोड होता है, आपके फ़ोन पर रहता है और फिर ऑफ़लाइन चलता है। इंस्टॉल होने के बाद हर नया कट-आउट अपने-आप उसका उपयोग करता है। खुली हुई फ़ोटो को दोबारा बनाने के लिए HD में कटआउट दोबारा बनाएँ पर टैप करें।",
  "helpBrushTitle": "ब्रश",
  "helpBrush1": "मिटाएँ विषय के कुछ हिस्से हटाता है। वापस लाएँ वे हिस्से लौटाता है जिन्हें कट-आउट ने हटा दिया था।",
  "helpBrush2": "पेंट करने के लिए एक उँगली से खींचें। 8 गुना तक ज़ूम करने और फ़ोटो को खिसकाने के लिए दो उँगलियों का उपयोग करें। ब्रश स्क्रीन पर अपना आकार बनाए रखता है, इसलिए ज़ूम करने पर आप ज़्यादा सटीक काम कर पाते हैं।",
  "helpBrush3": "ब्रश का आकार 1 से 50 तक होता है। अपारदर्शिता तय करती है कि हर स्ट्रोक कितना गहरा होगा।",
  "helpBrush4": "पूर्ववत करें और फिर करें आपके ब्रश स्ट्रोक में आगे-पीछे जाते हैं। रीसेट सारे स्ट्रोक मिटाकर ऑटोमैटिक कट-आउट पर लौटता है; पहले पुष्टि माँगी जाती है।",
  "helpBackgroundTitle": "बैकग्राउंड",
  "helpBackground1": "चुनें कि विषय के पीछे क्या हो: पारदर्शी, सफ़ेद, काला, ग्रेडिएंट, कोई रंग, आपकी फ़ोटो की धुंधली कॉपी या आपकी अपनी फ़ोटो।",
  "helpBackground2": "एक समय में केवल एक बैकग्राउंड इस्तेमाल होता है। आपकी आख़िरी पसंद पिछली को बदल देती है।",
  "helpBackground3": "कस्टम बैकग्राउंड जोड़ें से आप गैलरी से कोई फ़ोटो चुन सकते हैं। कस्टम रंग रंग चुनने वाला खोलता है। धुंधला स्लाइडर 0 से 25 तक जाता है।",
  "helpBackground4": "संपादन के दौरान पारदर्शी शतरंज जैसा पैटर्न दिखाता है। पारदर्शिता बनाए रखने के लिए PNG के रूप में एक्सपोर्ट करें।",
  "helpTemplatesTitle": "टेम्पलेट",
  "helpTemplates1": "टेम्पलेट पाँच समूहों में तैयार बैकग्राउंड हैं: स्टूडियो, कलर ब्लॉक, टेक्सचर, रोशनी और छाया, और ग्रेडिएंट और पैटर्न। पैनल में पाँच दृश्य दिखते हैं; सभी देखने के लिए टेम्पलेट बटन पर टैप करें।",
  "helpTemplates2": "टेम्पलेट चुनना अपनी फ़ोटो को बैकग्राउंड चुनने जैसा ही है: वह आपकी पिछली बैकग्राउंड पसंद को बदल देता है।",
  "helpLayoutTitle": "लेआउट",
  "helpLayout1": "विषय को हिलाने के लिए फ़ोटो पर उसे खींचें। आकार बदलने के लिए दो उँगलियों से पिंच करें।",
  "helpLayout2": "अंतिम छवि का आकार तय करने के लिए मूल, 1:1, 4:5 या 9:16 चुनें।",
  "helpLayout3": "आकार तय करता है कि विषय कितना बड़ा हो, 20% से 300% तक। छाया तय करती है कि उसकी छाया कितनी गहरी हो। ऑटो-सेंटर विषय को वापस बीच में लाता है। रीसेट खिसकाने और आकार बदलने को पूर्ववत करता है।",
  "helpLayout4": "यह आकार तब लागू होता है जब एक्सपोर्ट का आकार मूल हो। यदि आप एक्सपोर्ट शीट में कोई पहले से तय आकार या मार्केटप्लेस चुनते हैं, तो अंतिम आकार वही तय करता है।",
  "helpExportTitle": "एक्सपोर्ट",
  "helpExport1": "एक्सपोर्ट शीट खोलने के लिए एक्सपोर्ट पर टैप करें। जब तक आप गैलरी में सेव करें या शेयर करें पर टैप नहीं करते, कुछ भी लागू नहीं होता, इसलिए आप अपनी पसंद जितनी बार चाहें बदल सकते हैं।",
  "helpExport2": "PNG पारदर्शिता बनाए रखता है। JPG छोटी फ़ाइलें देता है लेकिन पारदर्शी नहीं हो सकता, इसलिए पारदर्शी बैकग्राउंड सफ़ेद हो जाता है। WEBP एक आधुनिक, कॉम्पैक्ट फ़ॉर्मैट है; यदि आपका फ़ोन उसे नहीं बना सकता, तो फ़ाइल JPG के रूप में सेव होती है। JPG और WEBP के लिए गुणवत्ता स्लाइडर फ़ाइल के आकार और बारीकी के बीच संतुलन बनाता है।",
  "helpExport3": "मूल आपकी फ़ोटो का आकार बनाए रखता है, उस आकृति के साथ जो आपने लेआउट में चुनी है। 1:1 यानी 1080 × 1080, 4:5 यानी 1080 × 1350 और 9:16 यानी 1080 × 1920। कस्टम से आप पिक्सल में चौड़ाई और ऊँचाई दर्ज कर सकते हैं।",
  "helpExport4": "मार्केटप्लेस प्रीसेट आकार, फ़ॉर्मैट और गुणवत्ता तय करते हैं: Amazon 2000 × 2000 JPG, eBay 1600 × 1600 JPG, Etsy 2667 × 2000 JPG 1 MB से कम, और Shopify 2048 × 2048 PNG। कोई एक चुनने पर आपकी फ़ॉर्मैट और आकार की पसंद बदल जाती है; बाद में फ़ॉर्मैट या आकार चुनने पर मार्केटप्लेस का चयन हट जाता है। मार्केटप्लेस के नियम बदल सकते हैं, इसलिए अपने मार्केटप्लेस की मौजूदा आवश्यकताएँ जाँच लें।",
  "helpExport5": "Amazon बिना छाया के शुद्ध सफ़ेद बैकग्राउंड भी इस्तेमाल करता है और विषय को इस तरह ढालता है कि वह फ़्रेम का अधिकांश हिस्सा भर दे। एडिटर में आपकी बैकग्राउंड पसंद नहीं बदलती। बाकी मार्केटप्लेस आपका बैकग्राउंड बनाए रखते हैं।",
  "helpExport6": "गैलरी में सेव करें और शेयर करें दोनों छवि को आपकी गैलरी और हाल के एक्सपोर्ट में सेव करते हैं। शेयर करें इसके अलावा आपके फ़ोन का शेयर मेनू भी खोलता है। यदि गैलरी में सेव करना संभव न हो, तो उसकी जगह शेयर मेनू खुलता है। एक्सपोर्ट के बाद आप होम स्क्रीन पर लौट आते हैं।",
  "helpExport7": "यदि आपने विज्ञापन नहीं हटाए हैं, तो एक्सपोर्ट के बाद एक विज्ञापन दिख सकता है, ज़्यादा से ज़्यादा हर दो मिनट में एक बार।",
  "helpBatchTitle": "बैच",
  "helpBatch1": "बैच एक साथ 30 फ़ोटो तक का कट-आउट बनाता है। होम स्क्रीन पर बैच पर टैप करें और अपनी फ़ोटो चुनें। बैच चलने के दौरान वापस जाने वाली बटन बंद रहती है।",
  "helpBatch2": "बैच की सभी फ़ोटो एक ही सेटिंग साझा करती हैं: एक बैकग्राउंड और एक मार्केटप्लेस। आप हर फ़ोटो के लिए अलग-अलग नहीं चुन सकते।",
  "helpBatch3": "बैकग्राउंड एडिटर की तरह ही काम करते हैं: आपकी अपनी फ़ोटो, रंग, टेम्पलेट, सफ़ेद, पारदर्शी, काला, धुंधला या ग्रेडिएंट। केवल एक लागू होता है, और आपकी आख़िरी पसंद पिछली को बदल देती है।",
  "helpBatch4": "फ़ाइल फ़ॉर्मैट आपके लिए चुना जाता है। मार्केटप्लेस के साथ फ़ोटो उसके आकार और फ़ॉर्मैट का पालन करती हैं। बिना मार्केटप्लेस के पारदर्शी बैकग्राउंड PNG देता है और बाकी हर बैकग्राउंड JPG, मूल आकार में।",
  "helpBatch5": "Amazon चुनने से बैकग्राउंड सफ़ेद हो जाता है; यदि आप बाद में कोई और बैकग्राउंड चुनते हैं, तो Amazon का चयन हट जाता है। eBay, Etsy और Shopify आपका बैकग्राउंड बनाए रखते हैं, लेकिन JPG पारदर्शी नहीं हो सकता, इसलिए उसे सफ़ेद बैकग्राउंड मिलता है।",
  "helpBatch6": "यदि HD मॉडल इंस्टॉल है, तो बैच की हर फ़ोटो का कट-आउट उसी से बनता है। टेम्पलेट के बगल की HD कटआउट पाएँ बटन उसे डाउनलोड करती है।",
  "helpBatch7": "हर फ़ोटो पूरी होते ही आपकी गैलरी और हाल के एक्सपोर्ट में सेव हो जाती है। रोकें मौजूदा फ़ोटो के बाद बैच को ख़त्म कर देता है, और जो फ़ोटो पहले ही पूरी हो चुकी हैं वे सेव रहती हैं। यदि कोई फ़ोटो विफल होती है, तो बैच चलता रहता है और बताता है कि कितनी प्रोसेस नहीं हो सकीं। हो गया आपको होम स्क्रीन पर वापस ले जाता है; यह कुछ सेव नहीं करता।",
  "helpLibraryTitle": "आपके एक्सपोर्ट",
  "helpLibrary1": "होम स्क्रीन पर हाल के एक्सपोर्ट आपके सबसे नए एक्सपोर्ट दिखाता है। सब देखने के लिए सभी देखें पर टैप करें, जो आज, कल, इस सप्ताह और पहले का में समूहित हैं।",
  "helpLibrary2": "किसी एक्सपोर्ट को फ़ुल स्क्रीन में खोलने के लिए उस पर टैप करें। एक्सपोर्ट के बीच बदलने के लिए स्वाइप करें और ज़ूम के लिए पिंच करें। नीचे की पट्टी में शेयर करें, गैलरी में सेव करें, फिर से संपादित करें और हटाएँ मिलते हैं।",
  "helpLibrary3": "थंबनेल पर तीन बिंदुओं वाली बटन वही क्रियाएँ खोलती है। फिर से संपादित करें एक्सपोर्ट की गई छवि को नई फ़ोटो की तरह खोलता है, इसलिए पिछले ब्रश स्ट्रोक वापस नहीं आते।",
  "helpLibrary4": "चुनें से आप कई एक्सपोर्ट चुनकर उन्हें एक साथ शेयर या हटा सकते हैं। सभी एक्सपोर्ट हटाएँ इस फ़ोन से सारे एक्सपोर्ट हटा देता है।",
  "helpLibrary5": "हटाने से एक्सपोर्ट सिर्फ़ PhotoSur से हटते हैं। जो छवियाँ पहले से आपकी गैलरी में सेव हैं उन्हें छुआ नहीं जाता। सभी देखें के सबसे नीचे आप देख सकते हैं कि इस फ़ोन पर एक्सपोर्ट कितनी जगह घेरते हैं।",
  "helpPrivacyTitle": "गोपनीयता और विज्ञापन",
  "helpPrivacy1": "आपकी फ़ोटो आपके फ़ोन पर ही प्रोसेस होती हैं और अपलोड नहीं की जातीं। कोई खाता नहीं है और कोई वॉटरमार्क नहीं है।",
  "helpPrivacy2": "PhotoSur मुफ़्त है, सभी सुविधाओं के साथ, और विज्ञापनों से चलता है। कुछ स्क्रीन के नीचे एक बैनर दिखता है, और एक्सपोर्ट के बाद एक विज्ञापन आ सकता है।",
  "helpPrivacy3": "सेटिंग्स में विज्ञापन हटाएँ एक बार की ख़रीदारी है जो विज्ञापन हटा देती है। यह और कुछ अनलॉक नहीं करती, क्योंकि सभी सुविधाएँ पहले से मुफ़्त हैं। खरीदारी बहाल करें इसे नए फ़ोन पर वापस ले आता है।",
  "helpSettingsTitle": "सेटिंग्स",
  "helpSettings1": "थीम आपके फ़ोन के अनुसार चल सकती है, या लाइट या डार्क हो सकती है। भाषा ऐप की भाषा बदलती है। दोनों होम स्क्रीन के हेडर में भी हैं।",
  "helpSettings2": "एडिट रिमाइंडर: यदि आप अधूरे संपादन के साथ ऐप छोड़ देते हैं, तो PhotoSur तीन घंटे बाद आपको याद दिला सकता है। इसे सेटिंग्स में बंद करें।",
  "helpSettings3": "HD कटआउट मॉडल बताता है कि वह इंस्टॉल है या नहीं। हटाएँ उसे जगह खाली करने के लिए आपके फ़ोन से मिटा देता है; आप उसे कभी भी दोबारा डाउनलोड कर सकते हैं।",
  "helpSettings4": "इंट्रो दोबारा देखें स्वागत स्क्रीन फिर से दिखाता है। सहायता सहायता पृष्ठ खोलती है। होम का एनिमेटेड बैकग्राउंड होम स्क्रीन के ऊपर चलती तस्वीर को चालू या बंद करता है।",
  "helpFixTitle": "कुछ गड़बड़ हो जाए तो",
  "helpFix1": "यदि ऑटोमैटिक कट-आउट बहुत पुराने या कम मेमोरी वाले फ़ोन पर नहीं चल पाता, तो ब्रश फिर भी काम करता है, इसलिए आप छवि को हाथ से पूरा कर सकते हैं।",
  "helpFix2": "यदि HD डाउनलोड रुक जाए, तो अपना कनेक्शन जाँचें और फिर से कोशिश करें। वह वहीं से आगे बढ़ता है जहाँ रुका था।",
  "helpFix3": "किसी भी और समस्या के लिए सेटिंग्स से सहायता खोलें।"
}
