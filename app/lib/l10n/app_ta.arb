  "settingsHdRemove": "நீக்கு",
  "settingsReplayIntro": "அறிமுகத்தை மீண்டும் காண்க",
  "homeSeeAll": "அனைத்தையும் காண்க",
  "exportActionEdit": "மீண்டும் திருத்து",
  "exportActionDelete": "நீக்கு",
  "exportMoreOptions": "மேலும் விருப்பங்கள்",
  "exportDeleteTitle": "இந்த ஏற்றுமதியை நீக்கவா?",
  "exportDeleteBody": "ஏற்றுமதி செய்த படங்கள் இந்த தொலைபேசியிலிருந்து நீக்கப்படும். உங்கள் அசல் புகைப்படங்களும் கேலரியில் சேமித்தவையும் பாதிக்கப்படாது.",
  "exportSavedToGallery": "உங்கள் கேலரியில் சேமிக்கப்பட்டது",
  "exportSaveFailed": "கேலரியில் சேமிக்க முடியவில்லை.",
